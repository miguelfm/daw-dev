# Copia este ficheiro como .env e axusta o que precises.
# Todo é opcional: sen .env úsanse estes mesmos valores.

# --- Imaxe PHP ---
# Imaxe pública xa construída; conserva a ruta histórica para permitir descargas sen login.
DAW_DEV_IMAGE=ghcr.io/miguelfm/dwcs-php
PHP_VERSION=8.5
# Só Linux: o teu UID/GID (comando `id`). En Windows/macOS déixao como está.
USER_UID=1000
USER_GID=1000

# --- Portos no anfitrión (cámbiaos se xa están ocupados) ---
WEB_PORT=80
PMA_PORT=8081
DB_PORT=3306

# --- Carpeta do código (DocumentRoot de Apache) ---
WWW_DIR=./www

# --- Xdebug: debug | develop | coverage | profile | off (combinables con comas) ---
XDEBUG_MODE=debug,develop

# --- MariaDB (lts = última versión de soporte longo) ---
MARIADB_VERSION=lts
DB_NAME=dwcs
DB_USER=dwcs
DB_PASSWORD=abc123.
DB_ROOT_PASSWORD=abc123.

# --- Volume de MariaDB ---
# Para unha instalación nova; véxase docs/renomeado-daw-dev.md para conservar datos antigos.
DB_VOLUME_NAME=daw-dev_db_data
DB_VOLUME_EXTERNAL=false
