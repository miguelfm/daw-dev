{
    // Opcional: abre VS Code DENTRO do contedor web (Dev Containers).
    // Reutiliza compose.yaml e engade os axustes de compose.devcontainer.yaml.
    "name": "DAW Dev PHP",
    "dockerComposeFile": ["../compose.yaml", "compose.devcontainer.yaml"],
    "service": "backend",
    "runServices": ["backend"],
    // Antes de buscar o contedor: Dev Containers usaría sen recrealo o que creou daw-start
    // ou un anterior a un cambio do proxecto. Sen bash nin Docker, non impide abrilo.
    "initializeCommand": "bash \"${localWorkspaceFolder}/scripts/daw.sh\" prepare-devcontainer || exit 0",
    "workspaceFolder": "/home/ad/daw",
    "remoteUser": "ad",
    "shutdownAction": "stopCompose",
    "customizations": {
        "vscode": {
            "settings": {
                // Dentro do contedor a shell é local; non se usa docker exec.
                "terminal.integrated.profiles.linux": {
                    "bash": {
                        "path": "/bin/bash"
                    }
                },
                "terminal.integrated.defaultProfile.linux": "bash"
            },
            "extensions": [
                "xdebug.php-debug",
                "bmewburn.vscode-intelephense-client"
            ]
        }
    }
}
