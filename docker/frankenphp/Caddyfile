{
	# A autoridade de certificación local non se instala no anfitrión:
	# o navegador avisará ata que confíes nela (ver README)
	skip_install_trust
	# Serve HTTP e HTTPS por igual, sen redirixir a HTTPS
	auto_https disable_redirects
	frankenphp
}

# http://          -> calquera nome, porto 80
# https://localhost -> porto 443 cun certificado local xerado por Caddy
http://, https://localhost {
	root * /var/www/html
	encode zstd br gzip

	# Todos os cartafoles: listaxe mesmo cando conteñen ficheiros índice.
	@cartafol {
		file {path}/
	}
	handle @cartafol {
		file_server {
			browse
			# O índice apunta ao propio directorio, nunca a un ficheiro.
			index .
		}
	}

	# O resto: executa o .php pedido, serve o ficheiro estático, ou, se non
	# existe, pasa a petición a /index.php (controlador frontal, sen .htaccess)
	handle {
		php_server
	}
}
